{ safe_quotes_on }
{ MOD_0 = "optistruct_feature_model.h3d" }
{ RES_0 = "optistruct_feature_model.h3d" }
*Id("HyperWorks", "8.*")
*BeginPage()
    *Title("Analysis Results", On)
    *Layout(1)
    *BeginAnimator(Static)
        *CurrentPosition(0)
        *NumberOfSteps(4)
        *Increment(Forward, Frame, 1, BounceOff)
    *EndAnimator()
    *BeginWindow(Animation)
        *BeginGraphic()
            *BeginModel({MOD_0}, "Hyper3D Reader", 1, 1)
                *ResultSource({RES_0}, "Hyper3D Reader", 1, 1)
                *BeginPart(999, "Global", "PART", 999)
                    *Attribute(On, IdOff, 1, Opa, Sha)
                *EndPart()
                *BeginPart(101, "Global", "PART", 101)
                    *Attribute(On, IdOff, 2, Opa, Sha)
                *EndPart()
                *BeginPart(102, "Global", "PART", 102)
                    *Attribute(On, IdOff, 3, Opa, Sha)
                *EndPart()
                *BeginPart(103, "Global", "PART", 103)
                    *Attribute(On, IdOff, 4, Opa, Sha)
                *EndPart()
                *BeginPart(104, "Global", "PART", 104)
                    *Attribute(On, IdOff, 5, Opa, Sha)
                *EndPart()
                *BeginPart(105, "Global", "PART", 105)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(109, "Global", "PART", 109)
                    *Attribute(On, IdOff, 10, Opa, Sha)
                *EndPart()
                *BeginPart(110, "Global", "PART", 110)
                    *Attribute(On, IdOff, 11, Opa, Sha)
                *EndPart()
                *BeginPart(1000, "Orphan-Grids", "PART", 0)
                    *Attribute(Off, IdOff, 37, Opa, Sha)
                *EndPart()
                *BeginGroup("Orphan Nodes", "Off", "Off", "255 255 255", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 3)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndGroup()
                *BeginMask()
                    *BeginSelection(Part, SelectAll, "User_Set", 0)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndMask()
            *EndModel()
            *CurrentModel(0)
            *View(Isometric)
        *EndGraphic()
    *EndWindow()
*EndPage()
